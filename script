if _G.JBPICK then pcall(_G.JBPICK) end

local Players = game:GetService("Players")
local LP      = Players.LocalPlayer
local mouse   = LP:GetMouse()
local cam     = workspace.CurrentCamera

local CTRL    = 0x11
local MAXD    = 700   -- studs: max range
local REFRESH = 5     -- s: cache rebuild interval
local SHORT   = 8     -- size of the refined shortlist

local PICKABLE = {
    Part = true, MeshPart = true, TrussPart = true,
    WedgePart = true, CornerWedgePart = true,
    UnionOperation = true, NegateOperation = true, IntersectOperation = true,
    SpawnLocation = true, Seat = true, VehicleSeat = true,
}

local alive, cands = true, {}
_G.JBPICK = function() alive = false end

task.spawn(function()
    while alive do
        local d = workspace:GetDescendants()
        local out, n = {}, 0
        for i = 1, #d do
            local o = d[i]
            if PICKABLE[o.ClassName] then n = n + 1 ; out[n] = o end
        end
        cands = out
        task.wait(REFRESH)
    end
end)

local SG = {-1, 1}

local function footprint(o)
    local cf, s = o.CFrame, o.Size
    if not cf or not s then return nil end
    local hx, hy, hz = s.X * 0.5, s.Y * 0.5, s.Z * 0.5
    local x0, y0, x1, y1, seen = math.huge, math.huge, -math.huge, -math.huge, 0
    for a = 1, 2 do for b = 1, 2 do for c = 1, 2 do
        local w = cf:PointToWorldSpace(Vector3.new(SG[a] * hx, SG[b] * hy, SG[c] * hz))
        local p, vis = WorldToScreen(w)
        if vis then
            seen = seen + 1
            if p.X < x0 then x0 = p.X end
            if p.X > x1 then x1 = p.X end
            if p.Y < y0 then y0 = p.Y end
            if p.Y > y1 then y1 = p.Y end
        end
    end end end
    if seen < 3 then return nil end
    return x0, y0, x1, y1
end

local function boxDist(mx, my, x0, y0, x1, y1)
    local dx = math.max(x0 - mx, 0, mx - x1)
    local dy = math.max(y0 - my, 0, my - y1)
    return math.sqrt(dx * dx + dy * dy)
end

local function pick(mx, my)
    local list  = cands
    local cpos  = cam.CFrame.Position
    local vp    = cam.ViewportSize
    local k     = (vp.Y * 0.5) / math.tan(math.rad(cam.FieldOfView) * 0.5)
    local maxd2 = MAXD * MAXD

    local sl, sn = {}, 0
    for i = 1, #list do
        local o = list[i]
        local pos = o.Position
        if pos then
            local ax, ay, az = pos.X - cpos.X, pos.Y - cpos.Y, pos.Z - cpos.Z
            local d2 = ax * ax + ay * ay + az * az
            if d2 > 1 and d2 <= maxd2 then
                local c, vis = WorldToScreen(pos)
                if vis then
                    local s = o.Size
                    local big = math.max(s.X, s.Y, s.Z)
                    local r = (big * 0.5) / math.sqrt(d2) * k
                    local sx, sy = c.X - mx, c.Y - my
                    local score = math.sqrt(sx * sx + sy * sy) - r
                    if sn < SHORT or score < sl[sn].sc then
                        local j = (sn < SHORT) and (sn + 1) or SHORT
                        sl[j] = {o = o, sc = score, d2 = d2}
                        while j > 1 and sl[j - 1].sc > sl[j].sc do
                            sl[j - 1], sl[j] = sl[j], sl[j - 1]
                            j = j - 1
                        end
                        if sn < SHORT then sn = sn + 1 end
                    end
                end
            end
        end
    end

    local bIn, bInD, bOut, bOutPx = nil, math.huge, nil, math.huge
    for i = 1, sn do
        local e = sl[i]
        local x0, y0, x1, y1 = footprint(e.o)
        local px = x0 and boxDist(mx, my, x0, y0, x1, y1) or e.sc
        if px <= 0 then
            if e.d2 < bInD then bInD = e.d2 ; bIn = e end
        elseif px < bOutPx then
            bOutPx = px ; bOut = e
        end
    end
    if bIn  then return bIn.o,  math.sqrt(bIn.d2)  end
    if bOut then return bOut.o, math.sqrt(bOut.d2) end
    return nil
end

local function report(o, dist)
    local s = o.Size
    print("Name  : " .. o.Name)
    print("Class : " .. o.ClassName)
    print(("Size  : %.2f, %.2f, %.2f"):format(s.X, s.Y, s.Z))
    print(("Dist  : %.1f studs"):format(dist))
    print("Touch : " .. tostring(o:FindFirstChild("TouchInterest") ~= nil))
    local fp = o:GetFullName()
    print("Path  : " .. fp)
    if pcall(setclipboard, fp) then print("(path copied to your clipboard)") end
    pcall(notify, o.Name .. " (" .. o.ClassName .. ")", "Pick", 4)
end

task.spawn(function()
    local armed = true
    while alive do
        if ismouse1pressed() and iskeypressed(CTRL) then
            if armed then
                armed = false
                local mx, my = mouse.X, mouse.Y
                local o, d = pick(mx, my)
                if o then
                    report(o, d)
                else
                    print(("nothing found at %d,%d"):format(mx, my))
                end
            end
        else
            armed = true
        end
        task.wait(0.03)
    end
end)

